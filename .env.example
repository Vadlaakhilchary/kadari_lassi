# Environment Configuration for Kadari Lassi Backend
# Copy this file to .env and update values for your deployment

# Flask Environment
FLASK_ENV=production
FLASK_DEBUG=False

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
# Leave empty to use current directory, or set to absolute path
DB_DIR=/path/to/database/directory

# CORS Configuration
# Add your domain(s) here, comma-separated (no spaces)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# Example for production:
# FLASK_ENV=production
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# DB_DIR=/var/kadari-lassi/data
# ALLOWED_ORIGINS=https://kadarilassi.com,https://www.kadarilassi.com
